# Credentials and sensitive data
*_creds.json
.env

# Git and version control related files
.git
.gitignore
.gitattributes

# CI/CD and repo metadata
ci/*
.github/*
.rabbit/

# macOS system files
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE files
.idea/
.vscode/
*.swp
*.swo

# Documentation and development-only files
docs/*
README.md
SECURITY.md
test/

# Local development scripts and helper files
Makefile
Makefile.help
Makefile.variables

# Build artifacts and temporary files
*.log
*.tmp
*.swp
*.bak
*.old

# Runtime defaults copied by Dockerfile live under src/configs.
# Keep the rest of src out of the image build context.
src/*
!src/configs/
!src/configs/**

# Formatter/editor local files
*.iml
.prettierignore
