# Variables
IMAGE_NAME ?= usabilitydynamics/udx-worker
TAG ?= latest
DOCKER_IMAGE := $(IMAGE_NAME):$(TAG)
CONTAINER_NAME ?= udx-worker-container
ENV_FILE ?= .env
TEST_WORKER_CONFIG ?= ./tests/configs/worker.yml
USER = udx
VOLUMES ?= ./src/scripts:/home/$(USER)
DEBUG ?= false
COMMAND ?= 
MULTIPLATFORM ?= false
FOLLOW_LOGS ?= false